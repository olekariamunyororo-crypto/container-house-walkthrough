{
  "expo": {
    "name": "Container House Walkthrough",
    "slug": "container-house-walkthrough",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.containerhouse"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.example.containerhouse"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
